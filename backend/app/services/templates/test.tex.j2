\documentclass[12pt]{article}
\usepackage[margin=1in]{geometry}
\usepackage{amsmath,amssymb}
\usepackage{enumitem}
\usepackage{fancyhdr}
\usepackage{needspace}

\pagestyle{fancy}
\fancyhf{}
\cfoot{Page \thepage}
\renewcommand{\headrulewidth}{0pt}

\begin{document}

\begin{center}
{\LARGE \textbf{Math Practice Test}}
\end{center}

\vspace{0.2cm}

\noindent Date: << date >> \hfill Test ID: << test_id|latex_escape >> \\
\noindent Difficulty: << difficulty|latex_escape >> \hfill Questions: << count >>

\vspace{0.5cm}
\noindent\rule{\textwidth}{0.4pt}
\vspace{0.3cm}

\section*{Questions}

\begin{enumerate}[leftmargin=2em, itemsep=10pt]
<% for q in questions %>
\Needspace{<< question_block_needspace_lines >>\baselineskip}
\item
\begin{samepage}
<< q.question_latex >>
<% if not loop.last %>
\vspace*{<< question_write_space_pt >>pt}
<% endif %>
\end{samepage}
<% endfor %>
\end{enumerate}

<% if include_answers %>
\newpage

\begin{center}
{\LARGE \textbf{Answer Key}}
\end{center}

\vspace{0.5cm}

\begin{enumerate}[leftmargin=2em, itemsep=8pt]
<% for q in questions %>
\item << q.answer_latex >>
<% endfor %>
\end{enumerate}
<% endif %>

<% if include_solutions %>
\newpage
\begin{center}
{\Large \textbf{Worked Solutions}}
\end{center}
\vspace{1em}
\begin{enumerate}[leftmargin=2em, itemsep=16pt]
<% for q in questions %>
\item
<% if q.solution_steps %>
\begin{enumerate}[label={\textbf{Step \arabic*:}}, leftmargin=3em, itemsep=4pt]
<% for step in q.solution_steps %>
\item << step >>
<% endfor %>
\end{enumerate}
<% else %>
<< q.answer_latex >>
<% endif %>
<% endfor %>
\end{enumerate}
<% endif %>

<% if include_topics %>
\vfill
\noindent\rule{\textwidth}{0.4pt}
\vspace{0.1cm}
\noindent {\small \textbf{Topics:} << topics|latex_escape >>}
<% endif %>

\end{document}
